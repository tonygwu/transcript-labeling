flowchart TB
  subgraph viewFrame["Preserve source, model evidence and human edits"]
  direction TB
  viewGuide["Which records change, and which evidence survives a new suggestion or wording correction?<br/>Original text fixes token coordinates. Private inference artifacts retain the prompt and raw response for offline resolution. A guarded item update replaces only tentative fields and saves draft history. Human labels and wording overlays stay separate. Exports expose each origin and the source hashes; no suggestion becomes human truth automatically. New confirmed ranges retain their own draft and bundle hashes. Legacy annotation evidence is marked separately, and absent historical links remain absent after later saves."]
  style viewGuide fill:#ffffff,stroke:#9ca3af,color:#111827
  n_source_preparation["Prepare original speech<br/>Program step - fixed rules | EXISTING<br/>Parse source captions without changing text; build a prompt from original speech and supplied identities."]
  n_exact_resolver["Resolve exact turn starts<br/>Program step - fixed rules | EXISTING<br/>Require unique exact anchors in marker windows and emit ordered speech-only ranges with hashes and model provenance."]
  n_review_service["Validate and save review data<br/>Program step - fixed rules | EXISTING<br/>Accept validated tentative bundles and authenticated human edits through separate routes; enforce source identity and stale-write checks."]
  n_dataset_files[("Private dataset files<br/>Saved data | EXISTING | [dataset-files]<br/>Keep original items, tentative draft history, human answers, corrections and review events in separate private JSON files.")]
  n_review_page["Read and correct the conversation<br/>Client application | EXISTING<br/>Group displayed speech by speaker and attribution source while preserving original caption intervals and word anchors."]
  n_export_builder["Export labels with their origin<br/>Program step - fixed rules | EXISTING<br/>Export human labels, correction overlays and tentative provenance separately; fill from suggestions only when explicitly requested."]
  n_run_artifacts[("Private inference artifacts<br/>Saved data | EXISTING | [run-artifacts]<br/>Retain prepared requests, raw adapter stdout and stderr, attempt records, derived bundles and success markers outside Git.")]
  n_dataset_files -->|"Read an existing original item | Original source and geometry [source-item]"| n_source_preparation
  n_source_preparation -->|"Write the private request | Prepared private request [inference-request]"| n_run_artifacts
  n_run_artifacts -->|"Resolve retained response without a model call | Prepared private request [inference-request], Untrusted response with identity evidence [model-response]"| n_exact_resolver
  n_exact_resolver -->|"Write the resolved private bundle | Validated tentative suggestions [suggestion-bundle]"| n_run_artifacts
  n_exact_resolver -->|"Caller explicitly imports or replaces suggestions | Validated tentative suggestions [suggestion-bundle]"| n_review_service
  n_dataset_files -->|"Read source, drafts and owner review state | Original source and geometry [source-item], Current and previous draft bundles [item-drafts], Explicit human speaker ranges [human-annotations], Human wording overlays [caption-corrections]"| n_review_service
  n_review_service -->|"Replace draft fields under source and bundle guards | Current and previous draft bundles [item-drafts]"| n_dataset_files
  n_review_service -->|"Serve the permitted reading and overlays | Browser reading and visible attribution [review-projection]"| n_review_page
  n_review_page -->|"Save explicit human edits with source and version checks | Explicit human speaker ranges [human-annotations], Human wording overlays [caption-corrections]"| n_review_service
  n_review_service -->|"Write human answers and correction history separately | Explicit human speaker ranges [human-annotations], Human wording overlays [caption-corrections]"| n_dataset_files
  n_review_service -->|"Request export kind, text policy and optional filling | Export selection [export-options]"| n_export_builder
  n_dataset_files -->|"Read original source, drafts and reviewed data | Original source and geometry [source-item], Current and previous draft bundles [item-drafts], Explicit human speaker ranges [human-annotations], Human wording overlays [caption-corrections]"| n_export_builder
  n_export_builder -->|"Return the provenance-preserving export | Portable review export [export-document]"| n_review_service
  end
