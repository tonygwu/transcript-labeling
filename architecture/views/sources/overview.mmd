flowchart LR
  subgraph viewFrame["From original conversation to reviewed labels"]
  direction LR
  viewGuide["How does source text become tentative speaker turns and then human-reviewed output?<br/>Start with original text and speaker identities. A caller-selected model proposes turns; deterministic code resolves exact words. A separate import attaches proposals. The person reviews the readable conversation, and exports retain the difference between suggestions and human decisions. Existing means implemented in this source, not deployed. The external adapter is an unverified caller dependency."]
  style viewGuide fill:#ffffff,stroke:#9ca3af,color:#111827
  n_source_preparation["Prepare original speech<br/>Program step - fixed rules | EXISTING<br/>Parse source captions without changing text; build a prompt from original speech and supplied identities."]
  n_adapter_runner["Run one configured attempt<br/>Program step - fixed rules | EXISTING<br/>Launch caller-selected executable arguments without a shell; retain raw receipts and cache successful results."]
  n_caller_model["Caller model operation<br/>Model call - one bounded task | UNCERTAIN<br/>Caller supplies a bounded inference adapter that returns exact response text and identity evidence; provider execution and isolation are outside this package."]
  n_exact_resolver["Resolve exact turn starts<br/>Program step - fixed rules | EXISTING<br/>Require unique exact anchors in marker windows and emit ordered speech-only ranges with hashes and model provenance."]
  n_review_service["Validate and save review data<br/>Program step - fixed rules | EXISTING<br/>Accept validated tentative bundles and authenticated human edits through separate routes; enforce source identity and stale-write checks."]
  n_review_page["Read and correct the conversation<br/>Client application | EXISTING<br/>Group displayed speech by speaker and attribution source while preserving original caption intervals and word anchors."]
  n_reviewer(["Person reviewing the transcript<br/>Person | EXISTING<br/>Confirm or change speakers, mark uncertainty, and correct wording through the browser."])
  n_export_builder["Export labels with their origin<br/>Program step - fixed rules | EXISTING<br/>Export human labels, correction overlays and tentative provenance separately; fill from suggestions only when explicitly requested."]
  n_source_preparation -->|"Pass the prepared request | Prepared private request [inference-request]"| n_adapter_runner
  n_adapter_runner -->|"Send prompt through stdin; await one adapter result | Adapter standard input [adapter-call]"| n_caller_model
  n_caller_model -->|"Return exact response and identity evidence | Untrusted response with identity evidence [model-response]"| n_adapter_runner
  n_adapter_runner -->|"Validate response against its prepared source | Prepared private request [inference-request], Untrusted response with identity evidence [model-response]"| n_exact_resolver
  n_exact_resolver -->|"Return validated proposal ranges | Validated tentative suggestions [suggestion-bundle]"| n_adapter_runner
  n_exact_resolver -->|"Caller explicitly imports or replaces suggestions | Validated tentative suggestions [suggestion-bundle]"| n_review_service
  n_review_service -->|"Serve the permitted reading and overlays | Browser reading and visible attribution [review-projection]"| n_review_page
  n_review_page -->|"Display grouped speech and original caption details | Browser reading and visible attribution [review-projection]"| n_reviewer
  n_reviewer -->|"Confirm speakers or correct wording | Explicit human speaker ranges [human-annotations], Human wording overlays [caption-corrections]"| n_review_page
  n_review_page -->|"Save explicit human edits with source and version checks | Explicit human speaker ranges [human-annotations], Human wording overlays [caption-corrections]"| n_review_service
  n_review_service -->|"Request export kind, text policy and optional filling | Export selection [export-options]"| n_export_builder
  n_export_builder -->|"Return the provenance-preserving export | Portable review export [export-document]"| n_review_service
  end
  style viewFrame fill:#ffffff,stroke:#cbd5e1
  classDef bounded_llm fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#111827
  classDef client fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#111827
  classDef deterministic fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#111827
  classDef human fill:#f3f4f6,stroke:#4b5563,stroke-width:2px,color:#111827
